# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID: Razorpay Key ID for UPI, Debit/Credit Card checkout in India (₹121 Monthly / ₹198 2-Month)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# RAZORPAY_KEY_SECRET: Razorpay Key Secret for verifying server-side payment signatures
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# BACKGROUND_REMOVAL_API_KEY: Optional external Background API provider secret
BACKGROUND_REMOVAL_API_KEY="YOUR_EXTERNAL_BG_API_KEY"
